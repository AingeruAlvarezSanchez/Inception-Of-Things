---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ item.name }}
  labels:
    app: {{ item.name }}
spec:
  replicas: {{ item.replicas }}
  selector:
    matchLabels:
      app: {{ item.name }}
  template:
    metadata:
      labels:
        app: {{ item.name }}
    spec:
      containers:
        - name: {{ item.name }}
          image: {{ item.image }}
          ports:
            - containerPort: {{ item.port }}
          volumeMounts:
            - name: custom-html
              mountPath: /usr/share/nginx/html/index.html
              subPath: index.html
      volumes:
        - name: custom-html
          configMap:
            name: {{ item.name }}-config
            items:
              - key: index.html
                path: index.html

---
apiVersion: v1
kind: Service
metadata:
  name: {{ item.name }}-svc
spec:
  selector:
    app: {{ item.name }}
  ports:
    - protocol: TCP
      port: {{ item.port }}
      targetPort: {{ item.port }}

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ item.name }}-ingress
  annotations:
    nginx.ingress.kubernetes.io/rewrite-target: /
spec:
  rules:
    - host: {{ item.ingress_host }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ item.name }}-svc
                port:
                  number: {{ item.port }}
    - host: ""
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: app3-svc
                port:
                  number: 80

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ item.name }}-config
data:
  index.html: |
    <!DOCTYPE html>
    <html lang="es">
    <head>
      <meta charset="utf-8" />
      <title>{{ item.name }}</title>
      <style>
        body{font-family:sans-serif;text-align:center;margin-top:15%}
        h1{font-size:3rem;color:#06c}
      </style>
    </head>
    <body>
      <h1>¡Hola, soy {{ item.name }}!</h1>
    </body>
    </html>
